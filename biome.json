{
  "$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "experimentalScannerIgnores": [".next"],
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "!src/components/ui/**",
      "!.next/**",
      "!.next"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noClassAssign": "info",
        "noMisleadingCharacterClass": "off",
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noBannedTypes": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "performance": "off",
      "a11y": {
        "noLabelWithoutControl": "off"
      }
    },
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.md",
      "!src/components/ui/**",
      "!.next/**",
      "!.next"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSameLine": true,
      "jsxQuoteStyle": "single",
      "bracketSpacing": true,
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
